rules_version = '2';
// Klien (browser) TIDAK boleh membaca/menulis apa pun secara langsung.
// Semua akses lewat API routes Vercel memakai Firebase Admin SDK (mengabaikan rules ini).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
