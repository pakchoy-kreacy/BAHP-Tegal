# Isi di Vercel > Settings > Environment Variables. JANGAN isi file ini dengan nilai asli lalu commit.
DATABASE_URL=     # connection string Neon (pilih yang "Pooled connection")
ADMIN_PIN=        # PIN admin awal + PIN cadangan (angka 6-12 digit). Bisa diganti di menu Pengaturan.
SESSION_SECRET=   # teks acak panjang (min. 16 karakter) untuk menandatangani sesi login
RATE_SALT=        # teks acak panjang (untuk meng-hash IP di pembatas spam)
# Opsional:
# WA_ADMIN=6285195565657   # nomor WA admin (default sudah ini)
