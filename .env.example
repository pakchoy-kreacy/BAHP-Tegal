# Salin ke Vercel > Settings > Environment Variables. JANGAN isi file ini dengan nilai asli lalu commit.
FIREBASE_SERVICE_ACCOUNT=   # isi seluruh JSON service account (atau versi base64-nya)
ADMIN_EMAILS=               # email admin dipisah koma, contoh: a@gmail.com,b@gmail.com
FIREBASE_WEB_API_KEY=       # Firebase > Project settings > Web app > apiKey
FIREBASE_PROJECT_ID=        # ID proyek Firebase
RATE_SALT=                  # teks acak panjang (untuk meng-hash IP)
# Opsional:
# FIREBASE_AUTH_DOMAIN=     # default: <project-id>.firebaseapp.com
# WA_ADMIN=6285195565657    # nomor WA admin (default sudah ini)
